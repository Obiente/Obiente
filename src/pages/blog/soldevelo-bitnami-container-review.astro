  ["os-shell", "12", "12", "amd64, arm64", "7a1e90bc74f01a61b63c0a46d367f6462340873778af972148d5540ecd4b3b23"],
  ["pgpool", "4", "4.7.2", "amd64, arm64", "37c172fffdf97b0ad37c191a4afe36763fb1f295ab8e7b0641444e910a9cf37d"],
