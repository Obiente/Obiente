  ["prometheus", "3.0, 3.11-3.13", "3.13.2", "amd64, arm64", "1da85660d87494d31a5c5ebf8657e5f09a0be53e9d3ccc62e1ec7a0a30b7f23e"],
  ["rabbitmq", "4.1, 4.3", "4.3.4", "amd64, arm64", "eb7d5a79521920007a32ae008efa9d83cbd3d5e18e0e93c9c6c5920b18b0953d"],
  ["redis", "6.2, 7.0, 8.6, 8.8", "8.8.1", "amd64, arm64", "b891b72ac3bd772c9105c4fdd9cf1b652a67023c71046bedd8d2e02f3d5254a6"],
  ["schema-registry", "8.2, 8.3", "8.3.0", "amd64, arm64", "7b5006857fd39e88cb02b5625db5bccfdaa93aca225615ce07aba175a92e0064"],
  ["zookeeper", "3.9", "3.9.5", "amd64, arm64", "27ae279832e8d562901d64b5b9d6f52596483d3f717253e76e16e413d1a7e816"],
];

const currentTagByFamily = new Map(
  catalog.map(([family, , currentVersion]) => [family, currentVersion]),
);

const contents = [
  ["#short-version", "Short version"],
  ["#scope", "Scope and limits"],
  ["#published-images", "Catalog inventory"],
  ["#malware-review", "Malware review"],
  ["#upstream-comparison", "Source lineage"],
  ["#notable-differences", "Material differences"],
  ["#provenance", "Distribution security"],
  ["#static-scans", "Published-layer scans"],
  ["#campaign", "Outreach pattern"],
  ["#recommendations", "For maintainers"],
  ["#methodology", "Reproduction"],
  ["#sources", "Primary sources"],
  ["#corrections", "Corrections"],
];

const findings = [
  ["Catalog reviewed", "15 image families, 40 versioned Dockerfiles, 1,080 source and runtime files", sources.catalogTree],
  ["Malware indicators", "None found within the stated static-analysis scope", "#malware-review"],
  ["Current published images", "15 current images and 29 Linux platform manifests inspected", "#published-images"],
  ["Runtime identity", "All 29 current platform manifests declare UID 1001", "#published-images"],
  ["Signatures and attestations", "None discoverable for any current catalog digest", "#provenance"],
  ["Publication defect", "Kafka's current manifests mix OCI and Docker media types", "#notable-differences"],
  ["Outreach snapshot", "375 PRs from one contributor account; 22 were merged", sources.campaignSearch],
