                <li><a href={sources.trivyRelease}>Trivy 0.72.0 release</a></li>
              </ul>
            </section>

            <section id="corrections" aria-labelledby="corrections-title">
              <p class="eyebrow">Corrections and response</p>
              <h2 id="corrections-title">This is a dated technical snapshot</h2>
