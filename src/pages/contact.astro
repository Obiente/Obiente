---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
---

<Layout
  title="Contact Obiente"
  description="Contact the Obiente team, contribute to our open projects, or join the community."
>
  <Navbar />
  <main>
    <Section spacing="xl">
      <Container size="xl">
        <header class="max-w-4xl pb-16 pt-8">
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-violet-300">
            Contact
          </p>
          <h1 class="text-5xl font-bold text-gray-100 md:text-7xl">
            Choose the right place for the conversation
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-100/60">
            Questions, bugs, ideas, and collaboration each work better in a
            different place. Start with the channel that matches what you need.
          </p>
        </header>

        <div class="border-t border-gray-100/20">
          <a
            href="mailto:contact@obiente.com"
            class="group grid gap-4 border-b border-gray-100/15 py-8 md:grid-cols-[0.65fr_1.5fr_auto] md:items-center"
          >
            <h2 class="text-2xl font-semibold text-gray-100 group-hover:text-violet-200">
              Email
            </h2>
            <p class="max-w-2xl text-sm leading-relaxed text-gray-100/55">
              General questions, partnerships, or anything that should not be
              discussed in public.
            </p>
            <span class="text-sm text-violet-300 underline decoration-violet-300/40 underline-offset-4">
              contact@obiente.com →
            </span>
          </a>

          <a
            href="https://github.com/Obiente"
            target="_blank"
            rel="noopener noreferrer"
            class="group grid gap-4 border-b border-gray-100/15 py-8 md:grid-cols-[0.65fr_1.5fr_auto] md:items-center"
          >
            <h2 class="text-2xl font-semibold text-gray-100 group-hover:text-violet-200">
              GitHub
            </h2>
            <p class="max-w-2xl text-sm leading-relaxed text-gray-100/55">
              Project issues, source code, technical discussions, and focused
              contributions.
            </p>
            <span class="text-sm text-violet-300 underline decoration-violet-300/40 underline-offset-4">
              Visit the organization →
            </span>
          </a>

          <a
            href="/join"
            target="_blank"
            rel="noopener noreferrer"
            class="group grid gap-4 border-b border-gray-100/15 py-8 md:grid-cols-[0.65fr_1.5fr_auto] md:items-center"
          >
            <h2 class="text-2xl font-semibold text-gray-100 group-hover:text-violet-200">
              Community
            </h2>
            <p class="max-w-2xl text-sm leading-relaxed text-gray-100/55">
              Conversation, project updates, and help from people around
              Obiente.
            </p>
            <span class="text-sm text-violet-300 underline decoration-violet-300/40 underline-offset-4">
              Join Discord →
            </span>
          </a>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</Layout>
