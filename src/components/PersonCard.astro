---
import Typography from "./Typography.astro";

export interface Props {
  name: string;
  image: string;
  description: string;
  role: string;
}

const { name, image, description, role } = Astro.props as Props;
---

<article class="flex h-full flex-col border-t border-gray-100/20 pt-7">
  <img
    src={image}
    alt={`${name} profile`}
    class="mb-6 h-20 w-20 rounded-full"
  />
  <div class="flex flex-col justify-between flex-1 gap-6">
    <span>
      <Typography as="h3" variant="subheading">{name}</Typography>
      <Typography variant="small">{description}</Typography>
    </span>
    <Typography
      variant="small"
      class="w-fit text-nowrap text-violet-300"
    >
      {role}
    </Typography>
  </div>
</article>
