---
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";

const principles = [
  {
    title: "Collect with a reason",
    description:
      "Data collection should have a clear product purpose. If a service does not need information, the best default is not to collect it.",
  },
  {
    title: "Keep choices visible",
    description:
      "Controls should be understandable and available where they matter, with practical ways to view, manage, or remove data when supported.",
  },
  {
    title: "Document the boundaries",
    description:
      "Each project should explain what it stores, where information goes, and which external services are involved.",
  },
  {
    title: "Design for independence",
    description:
      "We favor interoperable and self-hostable approaches where they fit, so control does not depend on one hosted platform forever.",
  },
];
---

<Section id="data-policy" spacing="xl">
  <Container size="xl">
    <header class="grid gap-6 border-b border-gray-100/20 pb-8 md:grid-cols-[1fr_1fr] md:items-end">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.16em] text-violet-300">
          Data and privacy
        </p>
        <h2 class="text-4xl font-bold text-gray-100 md:text-5xl">
          Promises should be verifiable
        </h2>
      </div>
      <p class="max-w-xl text-base leading-relaxed text-gray-100/60 md:justify-self-end">
        Obiente projects serve different purposes, so their exact data needs are
        not identical. We start with the least data a feature reasonably needs
        and document exceptions instead of hiding them behind a broad promise.
      </p>
    </header>

    <div class="grid md:grid-cols-2">
      {principles.map((principle, index) => (
        <article class={`border-b border-gray-100/15 py-8 md:min-h-44 ${index % 2 === 0 ? "md:border-r md:pr-10" : "md:pl-10"}`}>
          <h3 class="text-xl font-semibold text-gray-100">{principle.title}</h3>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-gray-100/55">
            {principle.description}
          </p>
        </article>
      ))}
    </div>

    <div class="flex flex-col gap-4 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-gray-100/50">
        Read the commitments shared across Obiente services.
      </p>
      <a
        href="https://github.com/Obiente/policies/blob/main/DATA_POLICY.md"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-violet-300 underline decoration-violet-300/40 underline-offset-4 hover:text-violet-200"
      >
        Read the complete data policy →
      </a>
    </div>
  </Container>
</Section>
